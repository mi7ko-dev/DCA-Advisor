{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steadyfolio.example/schemas/market-input.schema.json",
  "title": "SteadyFolio Offline Market Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["prices", "fx_rates"],
  "properties": {
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["listing_id", "amount", "currency", "as_of", "source_id"],
        "properties": {
          "listing_id": {"type": "string", "minLength": 1},
          "amount": {"$ref": "#/$defs/positive_decimal"},
          "currency": {"$ref": "#/$defs/currency"},
          "as_of": {"type": "string", "format": "date"},
          "source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "fx_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base_currency", "quote_currency", "rate", "as_of", "source_id"],
        "properties": {
          "base_currency": {"$ref": "#/$defs/currency"},
          "quote_currency": {"$ref": "#/$defs/currency"},
          "rate": {"$ref": "#/$defs/positive_decimal"},
          "as_of": {"type": "string", "format": "date"},
          "source_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "positive_decimal": {"type": "string", "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"}
  }
}
