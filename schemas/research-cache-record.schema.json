{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steadyfolio.example/schemas/research-cache-record.schema.json",
  "title": "SteadyFolio Append-Only Research Cache Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "asset_identity", "currency", "data_kind", "conclusion", "facts", "source_title", "publisher", "source_reference", "primary_source", "retrieved_at", "methodology", "coverage", "limitations", "assumptions", "freshness_basis", "terms_reference", "cache_mode", "redistribution_permitted"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^research:[0-9a-f]{32}$"},
    "asset_identity": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "data_kind": {"type": "string", "minLength": 1},
    "conclusion": {"type": "string", "minLength": 1},
    "facts": {"$ref": "#/$defs/stringArray"},
    "source_title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "primary_source": {"type": "boolean"},
    "source_as_of": {"type": "string", "format": "date"},
    "source_period": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "methodology": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1},
    "limitations": {"$ref": "#/$defs/stringArray"},
    "assumptions": {"$ref": "#/$defs/stringArray"},
    "freshness_basis": {"type": "string", "minLength": 1},
    "refresh_after": {"type": "string", "format": "date-time"},
    "material_event_trigger": {"type": "string", "minLength": 1},
    "terms_reference": {"type": "string", "minLength": 1},
    "cache_mode": {"enum": ["derived_summary", "citation_metadata"]},
    "redistribution_permitted": {"type": "boolean"}
  },
  "anyOf": [
    {"required": ["source_as_of"]},
    {"required": ["source_period"]}
  ],
  "allOf": [
    {
      "if": {"properties": {"cache_mode": {"const": "citation_metadata"}}, "required": ["cache_mode"]},
      "then": {"properties": {"facts": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
